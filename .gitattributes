# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Ensure these file types always have LF endings
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.po text eol=lf
*.pot text eol=lf
*.sh text eol=lf

# Binary files - don't touch
*.mo binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
